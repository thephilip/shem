#!/bin/sh
# shem — friendly front door for the Shem release.
#   start [--port N]   background, then print a verified status banner
#   stop               graceful shutdown, narrated (flush checkpoints, evacuate agents)
#   status             one-shot health
#   install <repo> [p] install a tool pack from a git repo (re-gates each tool)
#   attest <sid> [dir] export a session as an offline-verifiable bundle
#   gc <sid> [--keep N] prune a session's old events into a rollup digest
# Dispatches to the release launcher (bin/shem) that sits next to this script.
set -eu

REL_DIR="$(cd "$(dirname "$0")" && pwd)"
LAUNCHER="$REL_DIR/bin/shem"
HOST="${SHEM_HOST:-127.0.0.1}"
PORT="${SHEM_PORT:-4000}"
RELEASE_TMP="${RELEASE_TMP:-$REL_DIR/tmp}"
LOG_DIR="$RELEASE_TMP/log"
PORT_FILE="$RELEASE_TMP/shem.port"
# status/stop display the port a previous `start` chose (start re-derives its own below).
[ -f "$PORT_FILE" ] && PORT="$(cat "$PORT_FILE" 2>/dev/null || printf %s "$PORT")"

usage() { echo "usage: shem {start [--port N] | stop | status | install <repo> [path] | replay --check <session_id> | attest <session_id> [out_dir] | gc <session_id> [--keep N]}"; }

running() { "$LAUNCHER" pid >/dev/null 2>&1; }   # node up? dependency-free

health() {  # rich JSON if curl is around
  command -v curl >/dev/null 2>&1 && curl -fsS "http://$HOST:$PORT/api/health" 2>/dev/null
}

wait_up() {   # prefer the HTTP listener; fall back to node liveness. ~15s
  i=0
  while [ "$i" -lt 15 ]; do
    if command -v curl >/dev/null 2>&1; then
      if curl -fsS "http://$HOST:$PORT/api/health" >/dev/null 2>&1; then return 0; fi
    fi
    if running; then return 0; fi
    i=$((i + 1)); sleep 1
  done
  return 1
}

wait_down() { # ~30s — stop does real work (evacuation), so allow more than start
  i=0
  while [ "$i" -lt 30 ]; do
    running || return 0
    i=$((i + 1)); sleep 1
  done
  return 1
}

banner() {
  echo "Shem running  (pid $("$LAUNCHER" pid 2>/dev/null))"
  echo "  MCP   http://$HOST:$PORT/mcp/sse"
  echo "  REST  http://$HOST:$PORT/api"
  echo "  Web   http://$HOST:$PORT/"
  echo "  logs  $LOG_DIR/erlang.log.*"
  echo "  stop  shem stop"
}

cmd_start() {
  PORT="${SHEM_PORT:-4000}"   # start owns its default; ignore any stale port file
  while [ $# -gt 0 ]; do
    case "$1" in
      --port)   PORT="$2"; shift 2 ;;
      --port=*) PORT="${1#--port=}"; shift ;;
      *) echo "shem start: unknown option '$1'" >&2; exit 2 ;;
    esac
  done
  if running; then
    echo "Shem is already running at http://$HOST:$PORT/  (use 'shem stop' first)"
    exit 0
  fi
  echo "Starting Shem on :$PORT …"
  SHEM_PORT="$PORT" SHEM_HOST="$HOST" RELEASE_TMP="$RELEASE_TMP" "$LAUNCHER" daemon
  if wait_up; then
    mkdir -p "$RELEASE_TMP" 2>/dev/null || true
    printf '%s\n' "$PORT" > "$PORT_FILE" 2>/dev/null || true
    banner
  else
    echo "Shem did not come up on :$PORT within 15s." >&2
    echo "Check the log:  tail -n 50 $LOG_DIR/erlang.log.*" >&2
    exit 1
  fi
}

cmd_stop() {
  if ! running; then
    echo "Shem is not running."
    exit 0
  fi
  echo "Stopping Shem (pid $("$LAUNCHER" pid 2>/dev/null)) …"
  echo "  flushing checkpoints and evacuating agents (graceful) …"
  "$LAUNCHER" stop
  if wait_down; then
    rm -f "$PORT_FILE" 2>/dev/null || true
    echo "Shem stopped."
  else
    echo "Shem did not stop within 30s — it may still be evacuating. Re-check with 'shem status'." >&2
    exit 1
  fi
}

cmd_status() {
  if ! running; then
    echo "Shem is not running."
    exit 1
  fi
  out="$(health || true)"
  if [ -n "$out" ]; then
    echo "Shem running at http://$HOST:$PORT/"
    echo "$out"
  else
    echo "Shem running at http://$HOST:$PORT/  (install curl for detailed status)"
  fi
}

cmd_install() {  # bin/shem-install validates the URL and does the rpc; we add the friendly gate
  [ -n "${1:-}" ] || { echo "usage: shem install <repo> [path]" >&2; exit 2; }
  running || { echo "Shem is not running. Start it first:  shem start" >&2; exit 1; }
  echo "Installing pack from $1 (path: ${2:-.}) — re-gating each tool …"
  exec "$REL_DIR/bin/shem-install" "$@"
}

cmd_replay() {
  [ "${1:-}" = "--check" ] || { echo "usage: shem replay --check <session_id>" >&2; exit 2; }
  SID="${2:-}"
  # Session ids are ses_ + hex; the id is interpolated into Elixir source, so
  # reject anything else (quoting/injection safety).
  case "$SID" in
    ses_*)
      case "$SID" in
        *[!A-Za-z0-9_]*) echo "shem replay: '$SID' has invalid characters (expected ses_ + [A-Za-z0-9_])" >&2; exit 2 ;;
      esac
      ;;
    *)
      echo "shem replay: '$SID' does not look like a session id (ses_...)" >&2; exit 2 ;;
  esac
  if running; then
    echo "Shem is running — replay boots its own instance and would collide with the live data dir." >&2
    echo "Stop it first:  shem stop" >&2
    exit 2
  fi
  "$LAUNCHER" eval "System.halt(Shem.Replay.Check.cli(\"$SID\"))"
}

cmd_attest() {
  SID="${1:-}"
  case "$SID" in
    ses_*)
      case "$SID" in
        *[!A-Za-z0-9_]*) echo "shem attest: '$SID' has invalid characters (expected ses_ + [A-Za-z0-9_])" >&2; exit 2 ;;
      esac ;;
    *) echo "shem attest: '$SID' does not look like a session id (ses_...)" >&2; exit 2 ;;
  esac
  OUT="${2:-$PWD}"
  # $OUT is interpolated into Elixir source: reject quotes, backslashes, and
  # #{...} interpolation syntax (injection safety — same rationale as $SID above).
  case "$OUT" in
    *'"'*|*'\'*|*'#{'*) echo "shem attest: output dir may not contain quotes, backslashes, or '#{'" >&2; exit 2 ;;
  esac
  if running; then
    # read-only: run inside the live node (no DETS-lock collision, no need to stop).
    # release `rpc` always exits 0 and hides the return value, but IO reaches us —
    # so rpc_report prints a sentinel + dir and we set the exit code here.
    out="$("$LAUNCHER" rpc "Elixir.Shem.Attest.rpc_report(\"$SID\", \"$OUT\")" 2>&1)"
    if printf '%s\n' "$out" | head -n1 | grep -qx 'SHEM_ATTEST_OK'; then
      dir="$(printf '%s\n' "$out" | sed -n '2p')"
      echo "attest bundle written: $dir"
      echo "verify with:  python3 \"$dir/verify.py\" \"$dir\""
    else
      printf '%s\n' "$out" >&2
      exit 2
    fi
  else
    "$LAUNCHER" eval "System.halt(Shem.Attest.cli(\"$SID\", \"$OUT\"))"
  fi
}

cmd_gc() {
  SID="${1:-}"
  case "$SID" in
    ses_*)
      case "$SID" in
        *[!A-Za-z0-9_]*) echo "shem gc: '$SID' has invalid characters (expected ses_ + [A-Za-z0-9_])" >&2; exit 2 ;;
      esac ;;
    *) echo "shem gc: '$SID' does not look like a session id (ses_...)" >&2; exit 2 ;;
  esac
  KEEP="nil"
  case "${2:-}" in
    "") ;;
    --keep)
      case "${3:-}" in
        ''|*[!0-9]*) echo "shem gc: --keep expects a positive integer" >&2; exit 2 ;;
        *) KEEP="$3" ;;
      esac ;;
    --keep=*)
      K="${2#--keep=}"
      case "$K" in
        ''|*[!0-9]*) echo "shem gc: --keep expects a positive integer" >&2; exit 2 ;;
        *) KEEP="$K" ;;
      esac ;;
    *) echo "usage: shem gc <session_id> [--keep N]" >&2; exit 2 ;;
  esac
  if running; then
    # gc mutates, so it MUST run inside the live node (single writer). Release
    # rpc always exits 0 — sentinel dance, same as attest.
    out="$("$LAUNCHER" rpc "Elixir.Shem.GC.rpc_report(\"$SID\", $KEEP)" 2>&1)"
    if printf '%s\n' "$out" | head -n1 | grep -qx 'SHEM_GC_OK'; then
      printf '%s\n' "$out" | sed -n '2,$p'
    else
      printf '%s\n' "$out" >&2
      exit 2
    fi
  else
    "$LAUNCHER" eval "System.halt(Shem.GC.cli(\"$SID\", $KEEP))"
  fi
}

case "${1:-}" in
  start)   shift; cmd_start "$@" ;;
  stop)    shift; cmd_stop ;;
  status)  shift; cmd_status ;;
  install) shift; cmd_install "$@" ;;
  replay)  shift; cmd_replay "$@" ;;
  attest)  shift; cmd_attest "$@" ;;
  gc)      shift; cmd_gc "$@" ;;
  ""|-h|--help|help) usage ;;
  *) echo "shem: unknown command '$1'" >&2; usage >&2; exit 2 ;;
esac
