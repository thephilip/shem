#!/bin/sh
# shem-install <git-url> [subpath] [--grant <tool_id>]...
# Installs a tool pack into the running shem node. Each tool is re-verified
# through the graduation gate. Tools declaring an elevated sandbox profile
# (network/image/mounts) are rejected unless granted with --grant.
set -e
if [ -z "$1" ]; then
  echo "usage: shem-install <git-url> [subpath] [--grant <tool_id>]..." >&2
  exit 2
fi
REPO="$1"; shift
PATH_ARG="."
GRANTS=""
while [ $# -gt 0 ]; do
  case "$1" in
    --grant)
      shift
      [ -z "$1" ] && { echo "shem-install: --grant needs a tool id" >&2; exit 2; }
      case "$1" in *[!A-Za-z0-9._-]*) echo "shem-install: illegal characters in grant id" >&2; exit 2;; esac
      GRANTS="$GRANTS\"$1\"," ;;
    *) PATH_ARG="$1" ;;
  esac
  shift
done
case "$REPO" in
  https://*|git://*|ssh://*|git@*|file://*) ;;
  *) echo "shem-install: repo must be an https/git/ssh/git@/file URL" >&2; exit 2 ;;
esac
case "$REPO" in
  *[!A-Za-z0-9._:/~@+-]*) echo "shem-install: illegal characters in repo URL" >&2; exit 2 ;;
esac
case "$PATH_ARG" in
  *[!A-Za-z0-9._/-]*) echo "shem-install: illegal characters in subpath" >&2; exit 2 ;;
esac
GRANTS="[${GRANTS%,}]"
DIR="$(cd "$(dirname "$0")" && pwd)"
exec "$DIR/shem" rpc "Elixir.Shem.Lab.Pack.install(\"$REPO\", \"$PATH_ARG\", grants: $GRANTS) |> IO.inspect()"
