#!/bin/sh
# shem-install <git-url> [subpath]
# Installs a tool pack into the running shem node (start it with `mix shem.serve`
# or `bin/shem daemon`). Each tool is re-verified through the graduation gate.
set -e
if [ -z "$1" ]; then
  echo "usage: shem-install <git-url> [subpath]" >&2
  exit 2
fi
REPO="$1"
PATH_ARG="${2:-.}"
case "$REPO" in
  https://*|git://*|ssh://*|git@*|file://*) ;;
  *) echo "shem-install: repo must be an https/git/ssh/git@/file URL" >&2; exit 2 ;;
esac
case "$REPO" in
  *[!A-Za-z0-9._:/~@+-]*) echo "shem-install: illegal characters in repo URL" >&2; exit 2 ;;
esac
case "$PATH_ARG" in
  *[!A-Za-z0-9._/-]*) echo "shem-install: illegal characters in subpath" >&2; exit 2 ;;
esac
DIR="$(cd "$(dirname "$0")" && pwd)"
exec "$DIR/shem" rpc "Elixir.Shem.Lab.Pack.install(\"$REPO\", \"$PATH_ARG\") |> IO.inspect()"
